<configuration>
    <!-- Override via -DLOG_LEVEL=DEBUG or the Docker ENV var of the same name -->
    <property name="LOG_LEVEL" value="${LOG_LEVEL:-INFO}"/>
    <!-- Override via -DLOG_DIR=/path or the Docker ENV var; falls back to ~/.osrsbot/logs -->
    <property name="LOG_DIR" value="${LOG_DIR:-${user.home}/.osrsbot/logs}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/osrsbot.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/osrsbot.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <logger name="net.runelite.rsb" level="DEBUG"/>
</configuration>
